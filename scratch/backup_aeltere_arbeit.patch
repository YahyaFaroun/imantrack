+++ b/ImanTrack/Views/ForcedAlarmSetupView.swift
@@ -0,0 +1,228 @@
+import SwiftUI
+import VisionKit
+import Vision
+import CoreImage.CIFilterBuiltins
+
+struct ForcedAlarmSetupView: View {
+    @Environment(\.presentationMode) var presentationMode
+    
+    @AppStorage("isForcedFajrAlarmEnabled") private var isForcedFajrAlarmEnabled: Bool = false
+    @AppStorage("forcedAlarmUUID") private var forcedAlarmUUID: String = ""
+    @AppStorage("forcedAlarmEmergencyCode") private var forcedAlarmEmergencyCode: String = ""
+    @AppStorage("language") private var language: String = "de"
+    
+    @State private var currentUUID: String = ""
+    @State private var qrImage: UIImage?
+    @State private var showScanner = false
+    @State private var isScannedSuccessfully = false
+    @State private var newEmergencyCode: String = ""
+    @State private var scanErrorMessage: String? = nil
+    
+    var body: some View {
+        NavigationView {
+            ScrollView {
+                VStack(spacing: 24) {
+                    Text("Erzwungener Alarm einrichten")
+                        .font(.title2)
+                        .fontWeight(.bold)
+                        .padding(.top)
+                    
+                    Text("Damit du wirklich aufstehen musst, drucke diesen Code aus und hänge ihn z.B. im Badezimmer auf.\n\n1. Klicke auf 'Teilen / Drucken'\n2. Hänge den Zettel auf\n3. Gehe zum Zettel und mache den Probe-Scan")
+                        .font(.subheadline)
+                        .multilineTextAlignment(.center)
+                        .padding(.horizontal)
+                    
+                    if let image = qrImage {
+                        VStack(spacing: 16) {
+                            Image(uiImage: image)
+                                .interpolation(.none)
+                                .resizable()
+                                .scaledToFit()
+                                .frame(width: 200, height: 200)
+                                .padding()
+                                .background(Color.white)
+                                .cornerRadius(12)
+                                .shadow(radius: 5)
+                            
+                            ShareLink(item: Image(uiImage: image), preview: SharePreview("Fajr QR Code", image: Image(uiImage: image))) {
+                                Label("Teilen / Drucken", systemImage: "printer.fill")
+                                    .font(.headline)
+                                    .foregroundColor(.white)
+                                    .padding()
+                                    .frame(maxWidth: .infinity)
+                                    .background(Color.blue)
+                                    .cornerRadius(10)
+                            }
+                            .padding(.horizontal)
+                        }
+                    }
+                    
+                    Button(action: {
+                        showScanner = true
+                        scanErrorMessage = nil
+                    }) {
+                        Text(isScannedSuccessfully ? "Probe-Scan erfolgreich!" : "1. Probe-Scan durchführen")
+                            .font(.headline)
+                            .foregroundColor(.white)
+                            .padding()
+                            .frame(maxWidth: .infinity)
+                            .background(isScannedSuccessfully ? Color.green : Theme.islamicGreen)
+                            .cornerRadius(10)
+                    }
+                    .padding(.horizontal)
+                    
+                    if let error = scanErrorMessage {
+                        Text(error)
+                            .foregroundColor(.red)
+                            .font(.caption)
+                    }
+                    
+                    Divider().padding(.vertical)
+                    
+                    VStack(alignment: .leading, spacing: 10) {
+                        Text("Notfall-Override")
+                            .font(.headline)
+                        Text("Falls der QR-Code verloren geht oder die Kamera defekt ist, musst du diesen Code exakt abtippen, um den Alarm zu beenden. Bitte notiere ihn dir:")
+                            .font(.footnote)
+                            .foregroundColor(.secondary)
+                        
+                        Text(newEmergencyCode)
+                            .font(.system(.title3, design: .monospaced))
+                            .fontWeight(.bold)
+                            .padding()
+                            .frame(maxWidth: .infinity)
+                            .background(Color(UIColor.secondarySystemBackground))
+                            .cornerRadius(8)
+                            .textSelection(.enabled)
+                    }
+                    .padding(.horizontal)
+                    
+                    Button(action: {
+                        forcedAlarmUUID = currentUUID
+                        forcedAlarmEmergencyCode = newEmergencyCode
+                        isForcedFajrAlarmEnabled = true
+                        presentationMode.wrappedValue.dismiss()
+                    }) {
+                        Text("Aktivieren")
+                            .font(.headline)
+                            .foregroundColor(.white)
+                            .padding()
+                            .frame(maxWidth: .infinity)
+                            .background(isScannedSuccessfully ? Theme.islamicGreen : Color.gray)
+                            .cornerRadius(10)
+                    }
+                    .disabled(!isScannedSuccessfully)
+                    .padding(.horizontal)
+                    
+                    if !forcedAlarmUUID.isEmpty {
+                        Button(action: {
+                            resetCodes()
+                        }) {
+                            Text("QR-Code unwiderruflich neu generieren")
+                                .font(.footnote)
+                                .foregroundColor(.red)
+                        }
+                        .padding(.top, 10)
+                    }
+                }
+                .padding(.bottom, 30)
+            }
+            .navigationBarItems(trailing: Button("Abbrechen") {
+                presentationMode.wrappedValue.dismiss()
+            })
+            .onAppear {
+                setupNewCodes()
+            }
+            .sheet(isPresented: $showScanner) {
+                QRScannerView(targetUUID: currentUUID) { result in
+                    showScanner = false
+                    if result == currentUUID {
+                        isScannedSuccessfully = true
+                        scanErrorMessage = nil
+                    } else {
+                        isScannedSuccessfully = false
+                        scanErrorMessage = "Falscher Code gescannt."
+                    }
+                }
+            }
+        }
+    }
+    
+    private func setupNewCodes() {
+        if !forcedAlarmUUID.isEmpty {
+            self.currentUUID = forcedAlarmUUID
+            self.newEmergencyCode = forcedAlarmEmergencyCode
+        } else {
+            resetCodes()
+            return
+        }
+        self.qrImage = generateQRCode(from: self.currentUUID)
+    }
+    
+    private func resetCodes() {
+        let uuid = UUID().uuidString
+        self.currentUUID = uuid
+        self.newEmergencyCode = String(UUID().uuidString.prefix(8).uppercased())
+        self.qrImage = generateQRCode(from: self.currentUUID)
+        self.isScannedSuccessfully = false
+    }
+    
+    private func generateQRCode(from string: String) -> UIImage? {
+        let context = CIContext()
+        let filter = CIFilter.qrCodeGenerator()
+        let data = Data(string.utf8)
+        filter.setValue(data, forKey: "inputMessage")
+        
+        if let outputImage = filter.outputImage {
+            let transform = CGAffineTransform(scaleX: 10, y: 10)
+            let scaledImage = outputImage.transformed(by: transform)
+            if let cgImage = context.createCGImage(scaledImage, from: scaledImage.extent) {
+                return UIImage(cgImage: cgImage)
+            }
+        }
+        return nil
+    }
+}
+
+struct QRScannerView: UIViewControllerRepresentable {
+    let targetUUID: String
+    var onResult: (String) -> Void
+    
+    func makeUIViewController(context: Context) -> DataScannerViewController {
+        let scanner = DataScannerViewController(
+            recognizedDataTypes: [.barcode(symbologies: [.qr])],
+            qualityLevel: .fast,
+            recognizesMultipleItems: false,
+            isHighFrameRateTrackingEnabled: true,
+            isHighlightingEnabled: true
+        )
+        scanner.delegate = context.coordinator
+        return scanner
+    }
+    
+    func updateUIViewController(_ uiViewController: DataScannerViewController, context: Context) {
+        if DataScannerViewController.isSupported && DataScannerViewController.isAvailable {
+            try? uiViewController.startScanning()
+        }
+    }
+    
+    func makeCoordinator() -> Coordinator {
+        Coordinator(self)
+    }
+    
+    class Coordinator: NSObject, DataScannerViewControllerDelegate {
+        let parent: QRScannerView
+        
+        init(_ parent: QRScannerView) {
+            self.parent = parent
+        }
+        
+        func dataScanner(_ dataScanner: DataScannerViewController, didAdd addedItems: [RecognizedItem], allItems: [RecognizedItem]) {
+            if let item = addedItems.first, case .barcode(let barcode) = item {
+                if let payloadString = barcode.payloadStringValue {
+                    parent.onResult(payloadString)
+                }
+            }
+        }
+    }
+}
