  },
  {
    "start": 296.36,
    "duration": 4.44,
    "text": "اللهم بك اصبحنا"
  },
  {
    "start": 299.8,
    "duration": 7.2,
    "text": "بك"
  },
  {
    "start": 300.8,
    "duration": 9.839,
    "text": "امسينا وبك نحيا وبك نموت واليك"
  },
  {
    "start": 307.0,
    "duration": 7.36,
    "text": "النشور اصبحنا على فطره"
  },
  {
    "start": 310.639,
    "duration": 7.881,
    "text": "الاسلام وعلى كلمه"
  },
  {
    "start": 314.36,
    "duration": 11.48,
    "text": "الاخلاص وعلى دين نبينا"
  },
  {
    "start": 318.52,
    "duration": 11.28,
    "text": "محمد صلى الله عليه وسلم وعلى مله ابينا"
  },
  {
    "start": 325.84,
    "duration": 6.88,
    "text": "ابراهيم حنيفا مسلما"
  },
  {
    "start": 329.8,
    "duration": 4.6,
    "text": "وما كان من"
  },
  {
    "start": 332.72,
    "duration": 8.24,
    "text": "المشركين"
  },
  {
    "start": 334.4,
    "duration": 13.32,
    "text": "اللهم اني اسالك العافيه في الدنيا"
  },
  {
    "start": 340.96,
    "duration": 12.2,
    "text": "والاخره اللهم اني اسالك العفو والعافيه"
