  {
    "start": 347.72,
    "duration": 12.599,
    "text": "في ديني ودنياي واهلي"
  },
  {
    "start": 353.16,
    "duration": 11.92,
    "text": "ومالي اللهم استر عوراتي وامن روعاتي"
  },
  {
    "start": 360.319,
    "duration": 12.401,
    "text": "اللهم احفظني من بين يدي ومن"
  },
  {
    "start": 365.08,
    "duration": 11.44,
    "text": "خلفي وعن يميني وعن شمالي ومن فوقي واعوذ"
  },
  {
    "start": 372.72,
    "duration": 5.319,
    "text": "بعظمتك ان اغتال من"
  },
  {
    "start": 376.52,
    "duration": 9.799,
    "text": "تحتي"
  },
  {
    "start": 378.039,
    "duration": 8.28,
    "text": "اللهم اني اصبحت اشهدك واشهد حمله عرشك"
  },
  {
    "start": 387.08,
    "duration": 5.559,
    "text": "وملائكتك وجميع خلق"
  },
  {
    "start": 390.8,
