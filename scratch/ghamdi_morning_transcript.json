[
  {
    "start": 2.04,
    "duration": 6.16,
    "text": "اذكار الصباح والمساء اعوذ بالله من"
  },
  {
    "start": 6.359,
    "duration": 5.521,
    "text": "الشيطان"
  },
  {
    "start": 8.2,
    "duration": 9.319,
    "text": "الرجيم الله"
  },
  {
    "start": 11.88,
    "duration": 5.639,
    "text": "لا اله الا هو الحي"
  },
  {
    "start": 17.52,
    "duration": 5.72,
    "text": "القيوم لا تاخذه"
  },
  {
    "start": 20.68,
    "duration": 9.64,
    "text": "سنه ولا"
  },
  {
    "start": 23.24,
    "duration": 10.72,
    "text": "نوم له ما في السماوات وما في الارض من"
  },
  {
    "start": 30.32,
    "duration": 5.96,
    "text": "ذا الذي يشفع"
  },
  {
    "start": 33.96,
    "duration": 8.96,
    "text": "عنده الا"
  },
  {
    "start": 36.28,
    "duration": 10.16,
    "text": "باذنه يعلم ما بين ايديهم وما خلفهم ولا"
  },
  {
    "start": 42.92,
    "duration": 7.959,
    "text": "يحيطون بشيء من"
  },
  {
    "start": 46.44,
    "duration": 4.439,
    "text": "علمه الا بما"
  },
  {
    "start": 51.48,
    "duration": 11.639,
    "text": "شاء وسع كرسيه السماوات والارض ولا يؤوده"
  },
  {
    "start": 58.76,
    "duration": 9.2,
    "text": "حفظهما وهو العلي"
  },
  {
    "start": 63.119,
    "duration": 11.36,
    "text": "العظيم بسم الله الرحمن"
  },
  {
    "start": 67.96,
    "duration": 10.799,
    "text": "الرحيم قل هو الله احد الله الصمد لم يلد"
  },
  {
    "start": 74.479,
    "duration": 11.32,
    "text": "ولم يولد ولم يكن له كفوا"
  },
  {
    "start": 78.759,
    "duration": 11.841,
    "text": "احد قل هو الله احد الله الصمد لم يلد ولم"
  },
  {
    "start": 85.799,
    "duration": 10.801,
    "text": "يولد ولم يكن له كفوا احد"
  },
  {
    "start": 90.6,
    "duration": 14.24,
    "text": "قل هو الله احد الله الصمد لم يلد ولم"
  },
  {
    "start": 96.6,
    "duration": 12.92,
    "text": "يولد ولم يكن له كفوا احد بسم الله الرحمن"
  },
  {
    "start": 104.84,
    "duration": 13.36,
    "text": "الرحيم قل اعوذ برب الفلق"
  },
  {
    "start": 109.52,
    "duration": 10.72,
    "text": "من شر ما خلق ومن شر غاسق اذا وقب ومن شر"
  },
  {
    "start": 118.2,
    "duration": 10.279,
    "text": "النفاثات"
  },
  {
    "start": 120.24,
    "duration": 16.88,
    "text": "في العقد ومن شر حاسد اذا حسد قل اعوذ برب"
  },
  {
    "start": 128.479,
    "duration": 11.081,
    "text": "الفلق من شر ما خلق ومن شر غاسق اذا وقب"
  },
  {
    "start": 137.12,
    "duration": 9.96,
    "text": "ومن شر"
  },
  {
    "start": 139.56,
    "duration": 10.88,
    "text": "النفاثات في العقد ومن شر حاسد اذا حسد قل"
  },
  {
    "start": 147.08,
