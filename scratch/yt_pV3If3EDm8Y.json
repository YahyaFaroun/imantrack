[
  {
    "start": 0.39,
    "duration": 7.33,
    "text": "[موسيقى]"
  },
  {
    "start": 1.319,
    "duration": 10.24,
    "text": "اذكار النوم اعوذ بالله من الشيطان الرجيم"
  },
  {
    "start": 7.72,
    "duration": 10.52,
    "text": "بسم الله الرحمن"
  },
  {
    "start": 11.559,
    "duration": 13.72,
    "text": "الرحيم قل هو الله احد الله الصمد لم يلد"
  },
  {
    "start": 18.24,
    "duration": 9.24,
    "text": "ولم يولد ولم يكن له كفوا احد بسم الله"
  },
  {
    "start": 25.279,
    "duration": 10.841,
    "text": "الرحمن"
  },
  {
    "start": 27.48,
    "duration": 14.68,
    "text": "الرحيم قل اعوذ رب الفلق من شر ما خلق ومن"
  },
  {
    "start": 36.12,
    "duration": 12.72,
    "text": "شر غاسق اذا وقب ومن شر"
  },
  {
    "start": 42.16,
    "duration": 11.28,
    "text": "النفاثات في العقد ومن شر حاسد اذا"
  },
  {
    "start": 48.84,
    "duration": 9.6,
    "text": "حسد بسم الله الرحمن"
  },
  {
    "start": 53.44,
    "duration": 5.0,
    "text": "الرحيم قل اعوذ برب"
  },
  {
    "start": 58.92,
    "duration": 7.319,
    "text": "الناس ملك"
  },
  {
    "start": 62.44,
    "duration": 3.799,
    "text": "الناس اله"
  },
  {
    "start": 66.24,
    "duration": 5.84,
    "text": "الناس من شر الوسواس"
  },
  {
    "start": 73.04,
    "duration": 8.28,
    "text": "الخناس الذي يوسوس في صدور"
  },
  {
    "start": 79.04,
    "duration": 5.28,
    "text": "الناس من"
  },
  {
    "start": 81.32,
    "duration": 3.0,
    "text": "الجنه"
  },
  {
    "start": 85.28,
    "duration": 11.96,
    "text": "والناس بسم الله الرحمن الرحيم"
  },
  {
    "start": 91.04,
    "duration": 10.28,
    "text": "قل هو الله احد الله الصمد لم يلد ولم"
  },
  {
    "start": 97.24,
    "duration": 8.68,
    "text": "يولد ولم يكن له كفوا"
  },
  {
    "start": 101.32,
    "duration": 12.32,
    "text": "احد بسم الله الرحمن"
  },
  {
    "start": 105.92,
    "duration": 14.76,
    "text": "الرحيم قل اعوذ برب الفلق من شر ما خلق"
  },
  {
    "start": 113.64,
    "duration": 13.679,
    "text": "ومن شر غاسق اذا وقب ومن شر"
  },
  {
    "start": 120.68,
    "duration": 11.24,
    "text": "النفاثات في العقد ومن شر حاسد اذا"
  },
  {
    "start": 127.319,
    "duration": 9.601,
    "text": "حسد بسم الله الرحمن"
  },
  {
    "start": 131.92,
    "duration": 5.0,
    "text": "الرحيم قل اعوذ برب"
  },
  {
    "start": 137.28,
    "duration": 3.599,
    "text": "الناس ملك"
  },
  {
    "start": 140.92,
    "duration": 3.8,
    "text": "الناس اله"
  },
  {
    "start": 144.8,
    "duration": 12.719,
    "text": "الناس من شر الوسواس الخن"
  },
  {
    "start": 151.519,
    "duration": 8.281,
    "text": "الناس الذي يوسوس في صدور"
  },
  {
    "start": 157.519,
    "duration": 5.281,
    "text": "الناس من"
  },
  {
    "start": 159.8,
    "duration": 3.0,
    "text": "الجنه"
  },
  {
    "start": 163.76,
    "duration": 11.44,
    "text": "والناس بسم الله الرحمن"
  },
  {
    "start": 168.519,
    "duration": 12.281,
    "text": "الرحيم قل هو الله احد الله الصمد لم يلد"
  },
  {
    "start": 175.2,
    "duration": 9.2,
    "text": "ولم يولد ولم يكن له كفوا احد"
  },
  {
    "start": 180.8,
    "duration": 11.32,
    "text": "بسم الله الرحمن"
  },
  {
    "start": 184.4,
    "duration": 14.759,
    "text": "الرحيم قل اعوذ برب الفلق من شر ما خلق"
  },
  {
    "start": 192.12,
    "duration": 13.679,
    "text": "ومن شر غاسق اذا وقب ومن شر"
  },
  {
    "start": 199.159,
    "duration": 12.241,
    "text": "النفاثات في العقد ومن شر حاسد اذا"
  },
  {
    "start": 205.799,
    "duration": 9.561,
    "text": "حسد بسم الله الرحمن الرحيم"
  },
  {
    "start": 211.4,
    "duration": 3.96,
    "text": "قل اعوذ برب"
  },
  {
    "start": 215.72,
    "duration": 7.48,
    "text": "الناس ملك"
  },
  {
    "start": 219.36,
    "duration": 3.84,
    "text": "الناس اله"
  },
  {
    "start": 223.239,
    "duration": 5.761,
    "text": "الناس من شر الوسواس"
  },
  {
    "start": 229.959,
    "duration": 10.36,
    "text": "الخناس الذي يوسوس في صدور"
  },
  {
    "start": 236.0,
    "duration": 4.319,
    "text": "الناس من الجنه"
  },
  {
    "start": 242.72,
    "duration": 12.64,
    "text": "الناس اعوذ بالله من الشيطان الرجيم الله"
  },
  {
    "start": 249.48,
    "duration": 5.88,
    "text": "لا اله الا هو الحي"
  },
  {
    "start": 255.639,
    "duration": 6.761,
    "text": "القيوم لا تاخذه"
  },
  {
    "start": 258.959,
    "duration": 6.361,
    "text": "سنه ولا"
  },
  {
    "start": 262.4,
    "duration": 11.48,
    "text": "نوم له ما في"
  },
  {
    "start": 265.32,
    "duration": 8.56,
    "text": "السماوات وما في الارض من ذا الذي يشفع"
  },
  {
    "start": 274.12,
    "duration": 7.799,
    "text": "عنده الا"
  },
  {
    "start": 276.44,
    "duration": 9.039,
    "text": "باذنه يعلم ما بين ايديهم وما"
  },
  {
    "start": 281.919,
    "duration": 6.361,
    "text": "خلفهم ولا يحيطون"
  },
  {
    "start": 285.479,
    "duration": 7.201,
    "text": "بشيء من"
  },
  {
    "start": 288.28,
    "duration": 9.24,
    "text": "علمه الا بما"
  },
  {
    "start": 292.68,
    "duration": 8.72,
    "text": "شاء وسع كرسيه السماوات"
  },
  {
    "start": 297.52,
    "duration": 8.519,
    "text": "والارض ولا يؤ ده"
  },
  {
    "start": 301.4,
    "duration": 10.76,
    "text": "حفظهما وهو العلي"
  },
  {
    "start": 306.039,
    "duration": 8.641,
    "text": "العظيم اعوذ بالله من الشيطان الرجيم امن"
  },
  {
    "start": 312.16,
    "duration": 9.12,
    "text": "الرسول"
  },
  {
    "start": 314.68,
    "duration": 6.6,
    "text": "بما انزل اليه من ربه"
  },
  {
    "start": 321.919,
    "duration": 5.801,
    "text": "والمؤمنون كل امن بالله"
  },
  {
    "start": 328.039,
    "duration": 7.0,
    "text": "وملائكته وكت به"
  },
  {
    "start": 331.08,
    "duration": 9.8,
    "text": "ورسله لا نفرق بين"
  },
  {
    "start": 335.039,
    "duration": 12.081,
    "text": "احد من رسله وقالوا سمعنا"
  },
  {
    "start": 340.88,
    "duration": 12.2,
    "text": "واطعنا غفرانك ربنا واليك"
  },
  {
    "start": 347.12,
    "duration": 12.519,
    "text": "المصير لا يكلف الله نفسا الا"
  },
  {
    "start": 353.08,
    "duration": 9.239,
    "text": "وسعها لها ما كسبت وعليها ما اكتسبت رب"
  },
  {
    "start": 359.639,
    "duration": 6.96,
    "text": "بربنا لا"
  },
  {
    "start": 362.319,
    "duration": 6.641,
    "text": "تؤاخذنا ان"
  },
  {
    "start": 366.599,
    "duration": 7.201,
    "text": "نسينا او"
  },
  {
    "start": 368.96,
    "duration": 6.4,
    "text": "اخطانا ربنا ولا تحمل"
  },
  {
    "start": 373.8,
    "duration": 8.08,
    "text": "علينا"
  },
  {
    "start": 375.36,
    "duration": 10.48,
    "text": "اصرا كما حملته على الذين من"
  },
  {
    "start": 381.88,
    "duration": 8.28,
    "text": "قبلنا ربنا ولا"
  },
  {
    "start": 385.84,
    "duration": 5.84,
    "text": "تحملنا ما لا طاقه لنا به"
  },
  {
    "start": 390.16,
    "duration": 5.0,
    "text": "واعف"
  },
  {
    "start": 391.68,
    "duration": 5.16,
    "text": "عنا واغفر لنا"
  },
  {
    "start": 395.16,
    "duration": 5.439,
    "text": "وارحمنا"
  },
  {
    "start": 396.84,
    "duration": 6.24,
    "text": "انت مولانا"
  },
  {
    "start": 400.599,
    "duration": 6.961,
    "text": "فانصرنا"
  },
  {
    "start": 403.08,
    "duration": 4.48,
    "text": "فانصرنا على القوم"
  },
  {
    "start": 409.56,
    "duration": 10.84,
    "text": "الكافرين اذكار النوم بسمك ربي وضعت جنبي"
  },
  {
    "start": 415.8,
    "duration": 7.959,
    "text": "وبك ارفعه فان امسكت نفسي"
  },
  {
    "start": 420.4,
    "duration": 9.16,
    "text": "فارحمها وان ارسلتها"
  },
  {
    "start": 423.759,
    "duration": 5.801,
    "text": "فاحفظها بما تحفظ به عبادك"
  },
  {
    "start": 429.919,
    "duration": 11.761,
    "text": "الصالحين اللهم انك خلقت نفسي وانت"
  },
  {
    "start": 437.44,
    "duration": 7.599,
    "text": "توفاها لك مماتها"
  },
  {
    "start": 441.68,
    "duration": 9.919,
    "text": "ومحياها ان احييتها"
  },
  {
    "start": 445.039,
    "duration": 8.641,
    "text": "فاحفظها وان امتها فاغفر لها اللهم اني"
  },
  {
    "start": 451.599,
    "duration": 8.641,
    "text": "اسالك"
  },
  {
    "start": 453.68,
    "duration": 13.0,
    "text": "العافيه اللهم قني عذابك يوم تبعث"
  },
  {
    "start": 460.24,
    "duration": 9.639,
    "text": "عبادك اللهم قني عذابك يوم تبعث"
  },
  {
    "start": 466.68,
    "duration": 6.84,
    "text": "عبادك اللهم قني"
  },
  {
    "start": 469.879,
    "duration": 6.32,
    "text": "عذابك يوم تبعث"
  },
  {
    "start": 473.52,
    "duration": 5.98,
    "text": "عبادك بسمك"
  },
  {
    "start": 476.199,
    "duration": 4.521,
    "text": "اللهم اموت واحيا"
  },
  {
    "start": 479.5,
    "duration": 7.02,
    "text": "[موسيقى]"
  },
  {
    "start": 480.72,
    "duration": 9.96,
    "text": "اللهم رب السماوات السبع ورب العرش"
  },
  {
    "start": 486.52,
    "duration": 12.32,
    "text": "العظيم ربنا ورب كل"
  },
  {
    "start": 490.68,
    "duration": 8.16,
    "text": "شيء فالق الحب والنوى ومنزل التوراه"
  },
  {
    "start": 498.919,
    "duration": 8.72,
    "text": "والانجيل"
  },
  {
    "start": 501.919,
    "duration": 7.881,
    "text": "والفرقان اعوذ بك من شر كل شيء انت اخذ"
  },
  {
    "start": 507.639,
    "duration": 6.88,
    "text": "بناصيته"
  },
  {
    "start": 509.8,
    "duration": 9.799,
    "text": "اللهم انت الاول فليس قبلك"
  },
  {
    "start": 514.519,
    "duration": 10.32,
    "text": "شيء وانت الاخر فليس بعدك"
  },
  {
    "start": 519.599,
    "duration": 10.601,
    "text": "شيء وانت ظاهر فليس فوقك"
  },
  {
    "start": 524.839,
    "duration": 10.521,
    "text": "شيء وانت الباطن فليس دونك"
  },
  {
    "start": 530.2,
    "duration": 10.48,
    "text": "شيء اقض عنا الدين واغننا من"
  },
  {
    "start": 535.36,
    "duration": 8.88,
    "text": "الفقر الحمد لله الذي اطعمنا"
  },
  {
    "start": 540.68,
    "duration": 9.48,
    "text": "وسقانا وكفانا"
  },
  {
    "start": 544.24,
    "duration": 10.279,
    "text": "واوانا فكم ممن لا كافي له ولا"
  },
  {
    "start": 550.16,
    "duration": 11.04,
    "text": "مؤوي اللهم عالم الغيب"
  },
  {
    "start": 554.519,
    "duration": 9.241,
    "text": "والشهاده فاطر السماوات والارض رب كل شيء"
  },
  {
    "start": 561.2,
    "duration": 5.759,
    "text": "ومليكه اشهد ان"
  },
  {
    "start": 563.76,
    "duration": 10.24,
    "text": "لا اله الا"
  },
  {
    "start": 566.959,
    "duration": 11.201,
    "text": "انت اعوذ بك من شر نفسي ومن شر الشيطان"
  },
  {
    "start": 574.0,
    "duration": 8.0,
    "text": "وشركه وان اقترف على نفسي"
  },
  {
    "start": 578.16,
    "duration": 8.6,
    "text": "سوءا او اجره الى"
  },
  {
    "start": 582.0,
    "duration": 8.56,
    "text": "مسلم اللهم اسلمت نفسي"
  },
  {
    "start": 586.76,
    "duration": 8.0,
    "text": "اليك وفوضت امري"
  },
  {
    "start": 590.56,
    "duration": 9.24,
    "text": "اليك ووجهت وجهي"
  },
  {
    "start": 594.76,
    "duration": 7.92,
    "text": "اليك والجات ظهري اليك"
  },
  {
    "start": 599.8,
    "duration": 9.24,
    "text": "رغبه ورهبه"
  },
  {
    "start": 602.68,
    "duration": 11.12,
    "text": "اليك لا ملجا ولا منجا منك الا"
  },
  {
    "start": 609.04,
    "duration": 6.28,
    "text": "اليك امنت بكتابك الذي"
  },
  {
    "start": 613.8,
    "duration": 4.09,
    "text": "انزلت"
  },
  {
    "start": 615.32,
    "duration": 4.92,
    "text": "وبنبيك الذي"
  },
  {
    "start": 617.89,
    "duration": 8.629,
    "text": "[موسيقى]"
  },
  {
    "start": 620.24,
    "duration": 6.279,
    "text": "ارسلت اعوذ بالله من الشيطان"
  },
  {
    "start": 626.64,
    "duration": 5.6,
    "text": "الرجيم بسم الله ال الرحمن"
  },
  {
    "start": 633.04,
    "duration": 10.12,
    "text": "الرحيم تبارك الذي بيده الملك وهو على كل"
  },
  {
    "start": 640.16,
    "duration": 3.0,
    "text": "شيء"
  },
  {
    "start": 643.8,
    "duration": 12.92,
    "text": "قدير الذي خلق الموت والحياه ليبلوكم ايكم"
  },
  {
    "start": 650.92,
    "duration": 5.8,
    "text": "احسن عملا وهو العزيز"
  },
  {
    "start": 657.6,
    "duration": 6.16,
    "text": "الغفور الذي خلق سبع"
  },
  {
    "start": 661.959,
    "duration": 7.761,
    "text": "سماوات"
  },
  {
    "start": 663.76,
    "duration": 12.56,
    "text": "طباقا ما ترى في خلق الرحمن من"
  },
  {
    "start": 669.72,
    "duration": 6.6,
    "text": "تفاوت فارجع البصر هل ترى من"
  },
  {
    "start": 676.56,
    "duration": 9.399,
    "text": "فطور ثم ارجع البصر كرتين"
  },
  {
    "start": 682.76,
    "duration": 7.72,
    "text": "ينقلب اليك البصر"
  },
  {
    "start": 685.959,
    "duration": 5.961,
    "text": "خاسئا وهو حسير"
  },
  {
    "start": 690.48,
    "duration": 4.08,
    "text": "ولقد"
  },
  {
    "start": 691.92,
    "duration": 5.159,
    "text": "زينا"
  },
  {
    "start": 694.56,
    "duration": 4.16,
    "text": "السماء الدنيا"
  },
  {
    "start": 697.079,
    "duration": 6.681,
    "text": "بمصابيح"
  },
  {
    "start": 698.72,
    "duration": 5.04,
    "text": "وجعلناها رجوما للشياطين"
  },
  {
    "start": 704.68,
    "duration": 4.399,
    "text": "واعتدنا لهم عذاب"
  },
  {
    "start": 709.24,
    "duration": 11.0,
    "text": "السعير وللذين كفروا بربهم عذاب"
  },
  {
    "start": 715.24,
    "duration": 5.0,
    "text": "جهنم وبئس المصير"
  },
  {
    "start": 721.2,
    "duration": 8.6,
    "text": "اذا القوا فيها سمعوا لها"
  },
  {
    "start": 726.2,
    "duration": 3.6,
    "text": "شهيقا وهي"
  },
  {
    "start": 730.04,
    "duration": 5.28,
    "text": "تفور تكاد تميز من"
  },
  {
    "start": 735.36,
    "duration": 9.24,
    "text": "الغير"
  },
  {
    "start": 737.72,
    "duration": 12.2,
    "text": "كلما القي فيها فوج سالهم"
  },
  {
    "start": 744.6,
    "duration": 8.56,
    "text": "خزنتها الم ياتكم نذير"
  },
  {
    "start": 749.92,
    "duration": 4.8,
    "text": "قالوا بلى قد"
  },
  {
    "start": 753.16,
    "duration": 10.16,
    "text": "جاءنا"
  },
  {
    "start": 754.72,
    "duration": 11.4,
    "text": "نذير فكذبنا وقلنا ما نزل الله من شيء ان"
  },
  {
    "start": 763.32,
    "duration": 5.8,
    "text": "انتم الا في"
  },
  {
    "start": 766.12,
    "duration": 3.0,
    "text": "ضلال"
  },
  {
    "start": 769.36,
    "duration": 9.919,
    "text": "كبير وقالوا لو"
  },
  {
    "start": 772.6,
    "duration": 9.44,
    "text": "كنا نسمع او نعقل ما كنا فيه"
  },
  {
    "start": 779.279,
    "duration": 6.041,
    "text": "اصحاب"
  },
  {
    "start": 782.04,
    "duration": 8.56,
    "text": "السعير فاعترفوا"
  },
  {
    "start": 785.32,
    "duration": 5.28,
    "text": "بذنبهم فسحقا لاصحاب"
  },
  {
    "start": 790.92,
    "duration": 9.12,
    "text": "السعير ان الذين يخشون"
  },
  {
    "start": 795.92,
    "duration": 6.0,
    "text": "ربهم بالغيب لهم"
  },
  {
    "start": 800.04,
    "duration": 4.88,
    "text": "مغفره"
  },
  {
    "start": 801.92,
    "duration": 3.0,
    "text": "واجر"
  },
  {
    "start": 805.0,
    "duration": 7.36,
    "text": "كبير واسروا قولكم او اجهروا"
  },
  {
    "start": 810.639,
    "duration": 3.56,
    "text": "به"
  },
  {
    "start": 812.36,
    "duration": 5.599,
    "text": "انه"
  },
  {
    "start": 814.199,
    "duration": 3.76,
    "text": "عليم بذات"
  },
  {
    "start": 818.44,
    "duration": 7.079,
    "text": "الصدور الا يعلم من خلق وهو اللطيف"
  },
  {
    "start": 825.68,
    "duration": 10.92,
    "text": "الخبير هو الذي جعل لكم الارض"
  },
  {
    "start": 830.399,
    "duration": 10.201,
    "text": "ذلولا فامشوا في مناكبها وكلوا من رزقه"
  },
  {
    "start": 836.6,
    "duration": 4.0,
    "text": "واليه النشور"
  },
  {
    "start": 843.519,
    "duration": 10.841,
    "text": "اامنتم من في"
  },
  {
    "start": 847.04,
    "duration": 7.32,
    "text": "السماء ان يخسف بكم الارض فاذا هي"
  },
  {
    "start": 854.639,
    "duration": 6.601,
    "text": "تمور ام"
  },
  {
    "start": 857.56,
    "duration": 8.16,
    "text": "امنتم من في"
  },
  {
    "start": 861.24,
    "duration": 6.08,
    "text": "السماء ان يرسل عليكم"
  },
  {
    "start": 865.72,
    "duration": 5.28,
    "text": "حاصبا"
  },
  {
    "start": 867.32,
    "duration": 12.72,
    "text": "فستعلمون كيف"
  },
  {
    "start": 871.0,
    "duration": 9.04,
    "text": "نذير ولقد كذب الذين من قبلهم فكيف كان"
  },
  {
    "start": 880.399,
    "duration": 6.641,
    "text": "نكير اولم يروا الى الطير فوقهم"
  },
  {
    "start": 889.24,
    "duration": 4.56,
    "text": "صافات"
  },
  {
    "start": 891.12,
    "duration": 6.2,
    "text": "ويقبض ما"
  },
  {
    "start": 893.8,
    "duration": 3.52,
    "text": "يمسكهن الا"
  },
  {
    "start": 898.04,
    "duration": 4.0,
    "text": "الرحمن"
  },
  {
    "start": 899.72,
    "duration": 5.32,
    "text": "انه بكل"
  },
  {
    "start": 902.04,
    "duration": 3.0,
    "text": "شيء"
  },
  {
    "start": 905.279,
    "duration": 8.441,
    "text": "بصير ام منن هذا الذي هو"
  },
  {
    "start": 910.36,
    "duration": 8.039,
    "text": "جند لكم"
  },
  {
    "start": 913.72,
    "duration": 4.679,
    "text": "ينصركم من دون"
  },
  {
    "start": 919.0,
    "duration": 6.0,
    "text": "الرحمن ان الكافرون الا في"
  },
  {
    "start": 925.12,
    "duration": 8.399,
    "text": "غرور"
  },
  {
    "start": 927.04,
    "duration": 8.359,
    "text": "امن هذا ال الذي يرزقكم ان امسك رزقه بل"
  },
  {
    "start": 933.519,
    "duration": 4.88,
    "text": "لجوا في"
  },
  {
    "start": 935.399,
    "duration": 3.0,
    "text": "عتو"
  },
  {
    "start": 939.079,
    "duration": 8.88,
    "text": "ونفور افمن يمشي مكبا على"
  },
  {
    "start": 945.44,
    "duration": 8.639,
    "text": "وجهه"
  },
  {
    "start": 947.959,
    "duration": 9.12,
    "text": "اهداء ام من يمشي سويا على"
  },
  {
    "start": 954.079,
    "duration": 3.0,
    "text": "صراط"
  },
  {
    "start": 957.6,
    "duration": 4.84,
    "text": "مستقيم قل هو"
  },
  {
    "start": 960.6,
    "duration": 5.479,
    "text": "الذي"
  },
  {
    "start": 962.44,
    "duration": 6.72,
    "text": "انشاكم وجعل لكم السمع"
  },
  {
    "start": 966.079,
    "duration": 6.521,
    "text": "والابصار والافئده"
  },
  {
    "start": 969.16,
    "duration": 3.44,
    "text": "قليلا ما"
  },
  {
    "start": 972.639,
    "duration": 7.56,
    "text": "تشكرون قل هو الذي ذراكم في الارض واليه"
  },
  {
    "start": 980.319,
    "duration": 9.96,
    "text": "تحشرون ويقولون متى هذا الوعد ان"
  },
  {
    "start": 986.279,
    "duration": 4.0,
    "text": "كنتم صادقين"
  },
  {
    "start": 990.959,
    "duration": 5.101,
    "text": "قل"
  },
  {
    "start": 992.16,
    "duration": 6.159,
    "text": "انما العلم عند الله"
  },
  {
    "start": 996.06,
    "duration": 4.219,
    "text": "[موسيقى]"
  },
  {
    "start": 998.319,
    "duration": 4.96,
    "text": "وانما انا"
  },
  {
    "start": 1000.279,
    "duration": 3.0,
    "text": "نذير"
  },
  {
    "start": 1003.36,
    "duration": 4.0,
    "text": "مبين"
  },
  {
    "start": 1004.88,
    "duration": 4.92,
    "text": "فلما راوه"
  },
  {
    "start": 1007.36,
    "duration": 9.399,
    "text": "زلفه"
  },
  {
    "start": 1009.8,
    "duration": 11.0,
    "text": "سيئت وجوه الذين كفروا وقيل هذا الذي"
  },
  {
    "start": 1016.759,
    "duration": 11.16,
    "text": "كنتم به تد"
  },
  {
    "start": 1020.8,
    "duration": 12.159,
    "text": "عون قل ارايتم ان اهلكني الله ومن معي او"
  },
  {
    "start": 1027.919,
    "duration": 5.04,
    "text": "رحمنا فمن يجير"
  },
  {
    "start": 1033.079,
    "duration": 7.88,
    "text": "الكافرين فمن يجير الكافرين من عذاب"
  },
  {
    "start": 1041.16,
    "duration": 7.6,
    "text": "اليم قل هو الرحمن"
  },
  {
    "start": 1045.079,
    "duration": 5.201,
    "text": "امنا به وعليه توكلنا"
  },
  {
    "start": 1048.76,
    "duration": 4.72,
    "text": "[موسيقى]"
  },
  {
    "start": 1050.28,
    "duration": 6.2,
    "text": "فستعلمون من هو في"
  },
  {
    "start": 1053.48,
    "duration": 3.0,
    "text": "ضلال"
  },
  {
    "start": 1056.72,
    "duration": 9.92,
    "text": "مبين قل ارايتم ان اصبح"
  },
  {
    "start": 1062.0,
    "duration": 7.559,
    "text": "ماؤكم غورا فمن"
  },
  {
    "start": 1066.64,
    "duration": 6.919,
    "text": "ياتيكم"
  },
  {
    "start": 1069.559,
    "duration": 4.0,
    "text": "بماء معين"
  }
]